# Railway environment variables. Add these in the service's Variables tab;
# main.py will prefer them over the values in config.json.

DB_PASSWORD=
API_PASSWORD=

# Paste the FULL contents of the SSH private key file here, including the
# "-----BEGIN RSA PRIVATE KEY-----" and "-----END RSA PRIVATE KEY-----" lines
# and all the base64 lines in between. Railway's variable editor preserves
# newlines when you paste multi-line text.
SSH_PRIVATE_KEY=
